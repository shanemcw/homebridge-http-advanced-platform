{
  "displayName": "Homebridge HTTP Advanced Platform",
  "name": "homebridge-http-advanced-platform",
  "version": "2.1.0",
  "description": "Connect HTTP/HTTPS devices and REST APIs to HomeKit with JSON/XML mapping, polling and shared cached reads. A platform conversion of staromeste's homebridge-http-advanced-accessory with support for existing accessory configurations.",
  "license": "Apache-2.0",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "http",
    "https",
    "rest",
    "api",
    "json",
    "xml",
    "jsonpath",
    "xpath",
    "polling",
    "advanced",
    "platform",
    "accessory",
    "homekit",
    "cache",
    "switch",
    "sensor",
    "homebridge-http-advanced-accessory"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "homebridge": "^1.11.4 || ^2.4.0"
  },
  "author": "Shane McWhorter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanemcw/homebridge-http-advanced-platform.git"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "@xmldom/xmldom": "^0.9.12",
    "jsonpath-plus": "^10.4.0",
    "xpath": "0.0.34"
  },
  "homepage": "https://github.com/shanemcw/homebridge-http-advanced-platform#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "homebridge": "^2.4.0",
    "homebridge-v1": "npm:homebridge@^1.11.4",
    "legacy-plugin": "npm:homebridge-http-advanced-accessory@1.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts homebridge-ui --max-warnings=0",
    "test": "npm run build && node --test test/*.test.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && node scripts/release-guard.mjs"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE",
    "docs/migration.md",
    "docs/performance.md",
    "docs/service-support.md",
    "docs/modernization.md",
    "docs/configuration-examples.md",
    "docs/alpha-release-notes.md",
    "sample-config.json",
    "homebridge-ui",
    "docs/release-notes.md",
    "CHANGELOG.md",
    "docs/development-2.1.0.md"
  ],
  "bugs": {
    "url": "https://github.com/shanemcw/homebridge-http-advanced-platform/issues"
  },
  "contributors": [
    "tasict",
    "staromeste",
    "Shane McWhorter"
  ],
  "publishConfig": {
    "tag": "latest"
  }
}
